# Copy to .env and fill in with the values from your Supabase project
# (Dashboard > Project Settings > API).
#
# Only the public URL and the anon key belong here: row level security protects
# the data. The service_role key must never be added to the app.
EXPO_PUBLIC_SUPABASE_URL=https://your-project-ref.supabase.co
EXPO_PUBLIC_SUPABASE_ANON_KEY=your-anon-key
